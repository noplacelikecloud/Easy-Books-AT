# Caddy reverse proxy (#116)
# Default :80 handles local/IP access (http://localhost) seamlessly
:80 {
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /uploads/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
	encode gzip
}

# Optional TLS virtual hosts when custom domain names are configured
{$API_HOST:api.easy-books.app} {
	reverse_proxy backend:8000
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

{$APP_HOST:app.easy-books.app} {
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /uploads/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend:3000
	}
	encode gzip
}
